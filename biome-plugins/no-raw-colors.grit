engine biome(1.0)
language js(typescript,jsx)

or {
  JsStringLiteralExpression() as $literal,
  JsxString() as $literal
} where {
  $literal <: or {
    r"^['\"](?:gray|whiteAlpha|blackAlpha|white|black|red|orange|yellow|green|teal|blue|cyan|purple|pink)(?:\.[0-9]+|/[0-9]+|\.[0-9]+/[0-9]+)?['\"]$",
    r"^['\"](?:#[0-9a-fA-F]{3,8}|rgba?\(.*\)|hsla?\(.*\))['\"]$",
    r"^['\"].*var\(--chakra-colors-(?:gray|white-alpha|black-alpha|white|black|red|orange|yellow|green|teal|blue|cyan|purple|pink)[-)].*['\"]$"
  } where {
    $literal <: not within JsxAttribute(name = `colorPalette`),
    $literal <: not within JsPropertyObjectMember(name = `colorPalette`)
  },
  register_diagnostic(
    span = $literal,
    message = "Use a semantic color token from components/ui/provider.tsx instead of a raw color value."
  )
}
