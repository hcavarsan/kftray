# shellcheck disable=SC2148
FROM opensuse/tumbleweed@sha256:87320628e72328e23620f5d9ee319edf7d8f902703689dd72ad374fb74630dfa

RUN zypper refresh && \
    zypper addrepo https://download.opensuse.org/repositories/openSUSE:Tools/openSUSE_Tumbleweed/openSUSE:Tools.repo && \
    zypper --gpg-auto-import-keys refresh && \
    zypper install -y osc build git curl wget jq libxml2-tools tar gzip xz coreutils && \
    zypper clean -a

WORKDIR /workspace

CMD ["/bin/bash"]
